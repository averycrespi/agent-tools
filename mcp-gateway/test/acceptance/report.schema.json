{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mcp-gateway:s2-1-acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result",
    "revision",
    "dirty",
    "dirty_policy",
    "reason",
    "checks"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "result": { "enum": ["passed", "failed"] },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "dirty": { "type": "boolean" },
    "dirty_policy": { "enum": ["required_clean", "allowed"] },
    "reason": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "checks": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "command", "criteria", "artifacts"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "status": { "enum": ["passed", "failed"] },
          "command": { "type": "string", "minLength": 1, "maxLength": 512 },
          "criteria": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["AC-1", "AC-2", "AC-3", "AC-4", "AC-5", "AC-6"]
            }
          },
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 256 }
          }
        }
      }
    },
    "native": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "result",
        "platform",
        "reason",
        "evidence"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "result": { "enum": ["passed", "skipped", "failed"] },
        "platform": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "reason": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "evidence": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "status", "command"],
            "properties": {
              "name": { "type": "string" },
              "status": { "enum": ["passed", "skipped", "failed"] },
              "command": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
