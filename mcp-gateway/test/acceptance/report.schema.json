{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mcp-gateway:acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "profile_hash",
    "command_definition_hash",
    "result",
    "revision",
    "dirty",
    "dirty_policy",
    "clean_before",
    "clean_after",
    "started_at",
    "ended_at",
    "duration_ms",
    "reason",
    "checks"
  ],
  "properties": {
    "schema_version": { "const": 3 },
    "profile": { "enum": ["s2_1", "s3", "s4"] },
    "profile_hash": { "$ref": "#/$defs/sha256" },
    "command_definition_hash": { "$ref": "#/$defs/sha256" },
    "result": { "enum": ["passed", "failed"] },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "dirty": { "type": "boolean" },
    "dirty_policy": { "enum": ["required_clean", "allowed"] },
    "clean_before": { "type": "boolean" },
    "clean_after": { "type": "boolean" },
    "started_at": { "type": "string", "format": "date-time" },
    "ended_at": { "type": "string", "format": "date-time" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "reason": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "checks": {
      "type": "array",
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "command",
          "criteria",
          "artifacts",
          "started_at",
          "ended_at",
          "duration_ms",
          "timeout_ms",
          "timed_out",
          "termination",
          "cleanup",
          "diagnostic_paths"
        ],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "status": { "enum": ["passed", "failed"] },
          "command": { "type": "string", "minLength": 1, "maxLength": 512 },
          "criteria": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["AC-1", "AC-2", "AC-3", "AC-4", "AC-5", "AC-6"]
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/evidenceName" }
          },
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 256 }
          },
          "started_at": { "type": "string", "format": "date-time" },
          "ended_at": { "type": "string", "format": "date-time" },
          "duration_ms": { "type": "integer", "minimum": 0 },
          "timeout_ms": { "type": "integer", "minimum": 1 },
          "timed_out": { "type": "boolean" },
          "termination": { "enum": ["none", "term", "kill"] },
          "cleanup": { "enum": ["passed", "failed"] },
          "diagnostic_paths": {
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 256 }
          }
        }
      }
    },
    "evidence_manifest": {
      "type": "array",
      "minItems": 5,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "evidence"],
        "properties": {
          "criterion": {
            "enum": ["AC-1", "AC-2", "AC-3", "AC-4", "AC-5", "AC-6"]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/evidenceName" }
          }
        }
      }
    },
    "clause_manifest": {
      "type": "array",
      "minItems": 44,
      "maxItems": 44,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["clause", "tasks", "evidence"],
        "properties": {
          "clause": {
            "type": "string",
            "pattern": "^[A-Z]+-[0-9]+(?:\\.[0-9]+)?$"
          },
          "tasks": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^T(?:[1-9]|1[0-9]|2[01])$"
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/evidenceName" }
          }
        }
      }
    },
    "native": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "result",
        "platform",
        "reason",
        "evidence"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "result": { "enum": ["passed", "skipped", "failed"] },
        "platform": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "reason": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "evidence": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "status", "command"],
            "properties": {
              "name": { "type": "string" },
              "status": { "enum": ["passed", "skipped", "failed"] },
              "command": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "evidenceName": {
      "enum": [
        "contract",
        "authorization-race",
        "api-wire",
        "mcp-wire",
        "restore-canary",
        "e2e-lifecycle",
        "source-secret",
        "audit",
        "e2e-discovery",
        "source-slice",
        "strictjson-generated",
        "authorization-fuzz",
        "discovery-race",
        "authorization-integration",
        "ingress-race",
        "composition-race",
        "migration-restore",
        "integration",
        "e2e",
        "docs",
        "vulnerability",
        "native",
        "repository-check",
        "s4-contract",
        "s4-schema",
        "s4-admission-race",
        "s4-ingress-wire",
        "s4-composition-race",
        "s4-e2e-call",
        "s4-source-guards",
        "s4-docs",
        "s4-acceptance",
        "s4-audit",
        "s4-vulnerability",
        "s4-repository-check",
        "s4-invocation-race",
        "s4-repository-integration",
        "s4-catalog-race",
        "s4-downstream-race",
        "s4-lifecycle-race",
        "s4-e2e-lifecycle",
        "s4-redaction-fuzz",
        "s4-sanitizer-fuzz",
        "s4-e2e-privacy",
        "s4-source-privacy"
      ]
    }
  }
}
