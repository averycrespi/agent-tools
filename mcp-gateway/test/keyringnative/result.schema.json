{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "result", "platform", "reason", "evidence"],
  "properties": {
    "schema_version": { "const": 1 },
    "result": { "enum": ["passed", "skipped", "failed"] },
    "platform": { "type": "string", "pattern": "^[a-z0-9_-]{1,32}$" },
    "reason": { "type": "string", "pattern": "^[a-z0-9_]{1,64}$" },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "status", "command"],
          "properties": {
            "name": { "const": "deterministic_material_composition" },
            "status": { "enum": ["passed", "failed"] },
            "command": {
              "const": "go run ./test/acceptance/cmd run-suite test-material"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "status", "command"],
          "properties": {
            "name": { "const": "native_backend" },
            "status": { "enum": ["passed", "skipped", "failed"] },
            "command": {
              "const": "go run ./test/acceptance/cmd run-suite test-keyring-native"
            }
          }
        }
      ],
      "items": false
    }
  }
}
