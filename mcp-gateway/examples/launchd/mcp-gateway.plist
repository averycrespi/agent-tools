<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Run ./scripts/install-launchd-agent.sh from mcp-gateway/ to install this
     template with account-specific defaults; no manual editing is needed.
     See docs/operators/launchd.md for initialization, loading, and management.
     launchd does not expand shell variables or source shell profiles. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.agent-tools.mcp-gateway</string>
    <key>ProgramArguments</key>
    <array>
        <string>/ABSOLUTE/PATH/TO/mcp-gateway</string>
        <string>serve</string>
        <string>--data-dir</string>
        <string>/ABSOLUTE/PATH/TO/gateway-data</string>
        <string>--listen</string>
        <string>127.0.0.1:8210</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- Leave room for Gateway's ten-second drain before launchd forces exit. -->
    <key>ExitTimeOut</key>
    <integer>30</integer>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/ABSOLUTE/PATH/TO/gateway-logs/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/ABSOLUTE/PATH/TO/gateway-logs/stderr.log</string>
</dict>
</plist>
