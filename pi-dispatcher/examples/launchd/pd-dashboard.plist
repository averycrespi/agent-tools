<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent for `pd dashboard`. Runs Pi Dispatcher Dashboard in the
  background whenever the user is logged in.

  Before installing:
    1. Replace every occurrence of USERNAME below with your macOS short
       username (see `whoami`). The docs/launchd.md install snippet does this
       for you with sed.
    2. If `go install` put the binary somewhere other than ~/go/bin, update
       the ProgramArguments path accordingly.

  See docs/launchd.md ("Run Pi Dispatcher Dashboard as a launchd agent") for
  install and verify steps.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.agent-tools.pd-dashboard</string>

    <!-- The no-open flag suppresses an automatic browser tab on every launchd
         start. The authenticated URL is still printed to pd-dashboard.out.log. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/USERNAME/go/bin/pd</string>
        <string>dashboard</string>
        <string>--no-open</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- launchd does not source .zshrc/.bashrc. PATH is mostly defensive
             for any future helper execs; the dashboard command only needs the
             pd binary path above. -->
        <key>PATH</key>
        <string>/Users/USERNAME/go/bin:/opt/homebrew/bin:/usr/local/bin:/usr/local/go/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/USERNAME</string>

    <key>StandardOutPath</key>
    <string>/Users/USERNAME/Library/Logs/pd-dashboard.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/USERNAME/Library/Logs/pd-dashboard.err.log</string>
</dict>
</plist>
