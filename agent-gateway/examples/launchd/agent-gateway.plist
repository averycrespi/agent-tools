<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Operator-owned example for account alice: replace every path with the
     actual absolute path for your account before loading. Preserve existing
     installations; see docs/operators/launchd.md for stopped changes.
     launchd does not expand shell variables or source shell profiles. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.agent-tools.agent-gateway</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/alice/.local/bin/agent-gateway</string>
        <string>serve</string>
        <string>--data-dir</string>
        <string>/Users/alice/.local/share/agent-gateway</string>
        <string>--listen</string>
        <string>127.0.0.1:8210</string>
        <string>--http-proxy-listen</string>
        <string>127.0.0.1:8212</string>
        <string>--traffic-budget-bytes</string>
        <string>4294967296</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- Leave room for Gateway's ten-second drain before launchd forces exit. -->
    <key>ExitTimeOut</key>
    <integer>30</integer>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/alice/Library/Logs/agent-gateway/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/alice/Library/Logs/agent-gateway/stderr.log</string>
</dict>
</plist>
