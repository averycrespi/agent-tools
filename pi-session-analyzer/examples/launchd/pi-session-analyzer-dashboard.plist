<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent for the pi-session-analyzer dashboard. Serves the private
  loopback-only dashboard on a fixed port whenever the user is logged in.

  Before installing:
    1. Replace every occurrence of USERNAME below with your macOS short
       username (see `whoami`). The docs' install snippet does this for
       you with sed.
    2. If `go install` put the binary somewhere other than ~/go/bin, update
       the ProgramArguments path accordingly.
    3. Install the companion ingest agent (pi-session-analyzer-ingest.plist)
       first, or run `pi-session-analyzer ingest` once: the dashboard exits
       at startup until the database exists with a current schema, and
       launchd restart-throttles it until then.

  The dashboard binds literal 127.0.0.1 only and has no authentication.
  It renders private, scrubbed-but-identifying session content — do not
  port-forward or otherwise expose it.

  See docs/launchd.md for install, verify, and manage steps.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.agent-tools.pi-session-analyzer-dashboard</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/USERNAME/go/bin/pi-session-analyzer</string>
        <string>dashboard</string>
        <!-- A fixed port keeps the URL stable across restarts; the default
             (0) would choose a new ephemeral port every launch. Any free
             loopback port works. -->
        <string>--port</string>
        <string>31415</string>
        <!-- Without this, launchd would open a browser tab at every login
             and every KeepAlive restart. -->
        <string>--no-open</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>WorkingDirectory</key>
    <string>/Users/USERNAME</string>

    <key>StandardOutPath</key>
    <string>/Users/USERNAME/Library/Logs/pi-session-analyzer-dashboard.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/USERNAME/Library/Logs/pi-session-analyzer-dashboard.err.log</string>
</dict>
</plist>
