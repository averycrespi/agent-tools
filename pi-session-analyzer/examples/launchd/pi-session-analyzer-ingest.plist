<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent that periodically ingests new or changed Pi sessions so the
  dashboard and MCP index stay current. Ingest opens the database writably,
  which also applies any pending schema migrations; the dashboard itself is
  read-only and never migrates.

  Before installing:
    1. Replace every occurrence of USERNAME below with your macOS short
       username (see `whoami`). The docs' install snippet does this for
       you with sed.
    2. If `go install` put the binary somewhere other than ~/go/bin, update
       the ProgramArguments path accordingly.

  Ingest skips unchanged source files, so each run is cheap. It recomputes
  findings only for changed sessions — after upgrading a binary that adds
  detectors, run `pi-session-analyzer detect` once by hand to cover
  already-indexed sessions.

  See docs/launchd.md for install, verify, and manage steps.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.agent-tools.pi-session-analyzer-ingest</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/USERNAME/go/bin/pi-session-analyzer</string>
        <string>ingest</string>
    </array>

    <!-- Run at login so the database exists before the dashboard agent
         needs it, then every 15 minutes. -->
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>900</integer>

    <key>WorkingDirectory</key>
    <string>/Users/USERNAME</string>

    <key>StandardOutPath</key>
    <string>/Users/USERNAME/Library/Logs/pi-session-analyzer-ingest.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/USERNAME/Library/Logs/pi-session-analyzer-ingest.err.log</string>
</dict>
</plist>
